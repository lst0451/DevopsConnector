{
  "name": "devops-connector",
  "displayName": "DevOps Connector",
  "description": "Import, track and safely synchronize Azure DevOps work items as local Markdown.",
  "version": "0.2.1",
  "publisher": "devops-connector-local",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.95.0", "node": ">=22" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Import writes files and uses stored credentials. Trust the workspace first." },
    "virtualWorkspaces": { "supported": false, "description": "Version 0.1 requires a file-system workspace." }
  },
  "contributes": {
    "commands": [
      { "command": "devopsConnector.configure", "title": "Configuration", "category": "DevOps Connector", "icon": "$(gear)" },
      { "command": "devopsConnector.importWorkItem", "title": "Import Work Item", "category": "DevOps Connector" },
      { "command": "devopsConnector.trackExistingWorkItem", "title": "Track Existing Work Item", "category": "DevOps Connector" },
      { "command": "devopsConnector.showTrackedWorkItems", "title": "Show Tracked Work Items", "category": "DevOps Connector" },
      { "command": "devopsConnector.syncWorkItem", "title": "Sync Work Item", "category": "DevOps Connector" },
      { "command": "devopsConnector.syncAllWorkItems", "title": "Sync All Work Items", "category": "DevOps Connector" },
      { "command": "devopsConnector.previewChanges", "title": "View Remote Changes", "category": "DevOps Connector" },
      { "command": "devopsConnector.compareBaseline", "title": "Compare with Last Synced Version", "category": "DevOps Connector" },
      { "command": "devopsConnector.stopTracking", "title": "Stop Tracking Work Item", "category": "DevOps Connector" },
      {"command": "devopsConnector.configure.zh", "title": "配置 (Configuration)", "category": "DevOps Connector", "icon": "$(gear)"},
      {"command": "devopsConnector.importWorkItem.zh", "title": "导入工作项", "category": "DevOps Connector"},
      {"command": "devopsConnector.trackExistingWorkItem.zh", "title": "跟踪已有工作项", "category": "DevOps Connector"},
      {"command": "devopsConnector.showTrackedWorkItems.zh", "title": "查看已跟踪工作项", "category": "DevOps Connector"},
      {"command": "devopsConnector.syncWorkItem.zh", "title": "同步工作项", "category": "DevOps Connector"},
      {"command": "devopsConnector.syncAllWorkItems.zh", "title": "同步全部工作项", "category": "DevOps Connector"},
      {"command": "devopsConnector.previewChanges.zh", "title": "查看远端更改", "category": "DevOps Connector"},
      {"command": "devopsConnector.compareBaseline.zh", "title": "与上次同步版本比较", "category": "DevOps Connector"},
      {"command": "devopsConnector.stopTracking.zh", "title": "停止跟踪工作项", "category": "DevOps Connector"}
    ],
    "menus": {
      "commandPalette": [
      {"command": "devopsConnector.configure", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.importWorkItem", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.trackExistingWorkItem", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.showTrackedWorkItems", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.syncWorkItem", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.syncAllWorkItems", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.previewChanges", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.compareBaseline", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.stopTracking", "when": "config.devopsConnector.language == en"},
      {"command": "devopsConnector.configure.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.importWorkItem.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.trackExistingWorkItem.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.showTrackedWorkItems.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.syncWorkItem.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.syncAllWorkItems.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.previewChanges.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.compareBaseline.zh", "when": "config.devopsConnector.language != en"},
      {"command": "devopsConnector.stopTracking.zh", "when": "config.devopsConnector.language != en"}
      ],
      "view/title": [
      {"command": "devopsConnector.configure", "when": "view == workbench.explorer.fileView && isWorkspaceTrusted && config.devopsConnector.language == en", "group": "navigation@99"},
      {"command": "devopsConnector.configure.zh", "when": "view == workbench.explorer.fileView && isWorkspaceTrusted && config.devopsConnector.language != en", "group": "navigation@99"}
      ]
    },
    "configuration": {
      "title": "DevOps Connector",
      "properties": {
        "devopsConnector.language": {
          "type": "string", "enum": ["zh-CN", "en"], "default": "zh-CN", "scope": "application",
          "description": "DevOps Connector display language."
        },
        "devopsConnector.organizationUrl": {
          "type": "string", "default": "", "scope": "resource",
          "description": "Azure DevOps organization or project URL, e.g. https://vffice.visualstudio.com/ or https://dev.azure.com/my-org. The chosen hostname is preserved. No credentials."
        },
        "devopsConnector.project": {
          "type": "string", "default": "", "scope": "resource",
          "description": "Optional project name. Leave blank with an organization URL to look up work items by ID across projects."
        },
        "devopsConnector.saveDirectory": {
          "type": "string", "default": "docs/workitems", "scope": "resource",
          "description": "Relative directory inside the selected workspace folder. Absolute paths and parent traversal are not allowed."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "compile": "tsc && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "tsc && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run check && node scripts/build.mjs --production",
    "package": "vsce package --allow-missing-repository --skip-license --out work/devops-connector-0.2.1.vsix"
  },
  "dependencies": { "turndown": "7.2.5", "turndown-plugin-gfm": "1.0.2" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  }
}
